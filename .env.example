# Copy to .env and fill in.
# SQLite file for local dev, or libsql://<db>.turso.io for hosted libSQL
DATABASE_URL="file:./dev.db"
DATABASE_AUTH_TOKEN=""
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="change-me-to-a-random-string-of-at-least-32-chars"
APP_URL="http://localhost:3000"
# Comma-separated emails that can open /admin (usage metadata only, never health data)
ADMIN_EMAILS=""
# Email (OTP, warnings): a Gmail address and its 16-character App Password.
# Without these, sign-up skips email verification and no emails are sent.
SMTP_USER=""
SMTP_PASS=""
# MAIL_TRANSPORT="console"   # print emails to the server log instead (local testing)
SUPPORT_EMAIL=""
# Protects /api/cron/* (Vercel adds it automatically to cron requests)
CRON_SECRET=""
