# Copy to .env and fill in.
# SQLite file for local dev, or libsql://<db>.turso.io for hosted libSQL
DATABASE_URL="file:./dev.db"
DATABASE_AUTH_TOKEN=""
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="change-me-to-a-random-string-of-at-least-32-chars"
APP_URL="http://localhost:3000"
# Comma-separated emails that can open /admin (usage metadata only, never health data)
ADMIN_EMAILS=""
# Email (OTP, warnings): a Gmail address and its 16-character App Password.
# Without these, sign-up skips email verification and no emails are sent.
SMTP_USER=""
SMTP_PASS=""
# MAIL_TRANSPORT="console"   # print emails to the server log instead (local testing)
SUPPORT_EMAIL=""
# Protects /api/cron/* (Vercel adds it automatically to cron requests)
CRON_SECRET=""

# Test report photos/PDFs in Supabase Storage (free: 1 GB). Optional: without these, files go in the database.
# Supabase -> Project Settings -> API: Project URL and the service_role key (secret, server only).
# The private bucket is created automatically on first upload.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_BUCKET="health-files"

# Reading prescription photos with Google Gemini (free key: https://aistudio.google.com/apikey).
# Optional: without it, photos are read on the device (works offline, less accurate for handwriting).
GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-2.5-flash"
