// HealthTrack data model.
// Local dev uses SQLite (libSQL). For production switch `provider` to "postgresql"
// and the driver adapter in src/server/db/client-factory.ts (see README).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Plan {
  FREE
  PRO
}

enum TimeOfDay {
  MORNING
  AFTERNOON
  EVENING
  NIGHT
}

enum MealTiming {
  FASTING
  BEFORE_MEAL
  AFTER_MEAL
  BEDTIME
  RANDOM
}

enum GlucoseUnit {
  MG_DL
  MMOL_L
}

enum Arm {
  LEFT
  RIGHT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

/// Account owner (the person who logs in).
model User {
  id                  String          @id @default(cuid())
  email               String          @unique
  name                String
  passwordHash        String
  plan                Plan            @default(FREE)
  timezone            String          @default("Asia/Dhaka")
  /// Account standing, managed from /admin.
  status              AccountStatus   @default(ACTIVE)
  statusReason        String?
  statusChangedAt     DateTime?
  /// Usage metadata for the admin panel (throttled updates, no health data).
  lastLoginAt         DateTime?
  lastActiveAt        DateTime?
  /// Set once the user proves the email is theirs (OTP). Null = unverified.
  emailVerifiedAt     DateTime?
  /// WARNED: reply-by date. Missing it leads to suspension.
  warningDeadlineAt   DateTime?
  warningResponse     String?
  warningRespondedAt  DateTime?
  /// SUSPENDED: the account and its data are permanently deleted on this date.
  deletionScheduledAt DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  profiles            Profile[]
  activity            ActivityEvent[]
  codes               OneTimeCode[]
}

/// Short-lived emailed codes (email verification, password reset). Only a hash is stored.
model OneTimeCode {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// VERIFY_EMAIL | RESET_PASSWORD
  purpose    String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, purpose, createdAt])
}

/// What remains after an account is deleted: proof of when and why, no personal data.
model DeletedAccount {
  id        String   @id @default(cuid())
  /// SHA-256 of the email, so a repeat case can be recognised without keeping the address.
  emailHash String
  reason    String?
  deletedBy String
  deletedAt DateTime @default(now())

  @@index([emailHash])
}

enum AccountStatus {
  ACTIVE
  WARNED
  SUSPENDED
}

/// What a user did and when - never what they recorded. Powers the admin panel.
model ActivityEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// e.g. LOGIN, REPORT_DOWNLOAD (see src/domain/activity.ts)
  type      String
  /// Small non-health detail, e.g. "pdf".
  detail    String?
  /// Two-letter country from the edge (the IP itself is not stored).
  country   String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

/// Audit trail of admin decisions (who suspended whom, when and why).
model AdminAction {
  id           String   @id @default(cuid())
  adminEmail   String
  targetUserId String?
  targetEmail  String
  action       String
  reason       String?
  createdAt    DateTime @default(now())

  @@index([targetUserId, createdAt])
}

/// A patient whose data is tracked. One user can manage several (self, parents, ...).
model Profile {
  id                 String      @id @default(cuid())
  userId             String
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  relation           String      @default("Self")
  dateOfBirth        DateTime?
  gender             Gender?
  isDefault          Boolean     @default(false)
  glucoseUnit        GlucoseUnit @default(MG_DL)
  // Personal targets (doctor-adjustable). Glucose values are always stored in mg/dL.
  bpSystolicTarget   Int         @default(130)
  bpDiastolicTarget  Int         @default(80)
  glucoseLow         Int         @default(70)
  glucoseFastingMax  Int         @default(130)
  glucosePostMealMax Int         @default(180)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  bloodPressureReadings BloodPressureReading[]
  glucoseReadings       GlucoseReading[]
  medications           Medication[]
  prescriptions         Prescription[]
  conditions            HealthCondition[]
  labReports            LabReport[]
  shareLinks            ShareLink[]

  @@index([userId])
}

model BloodPressureReading {
  id         String    @id @default(cuid())
  profileId  String
  profile    Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  systolic   Int
  diastolic  Int
  pulse      Int?
  timeOfDay  TimeOfDay
  arm        Arm?
  measuredAt DateTime
  note       String?
  createdAt  DateTime  @default(now())

  @@index([profileId, measuredAt])
}

model GlucoseReading {
  id         String     @id @default(cuid())
  profileId  String
  profile    Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  valueMgDl  Float
  timeOfDay  TimeOfDay
  mealTiming MealTiming
  measuredAt DateTime
  note       String?
  createdAt  DateTime   @default(now())

  @@index([profileId, measuredAt])
}

model Medication {
  id             String        @id @default(cuid())
  profileId      String
  profile        Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name           String
  dosage         String
  schedule       String
  notes          String?
  /// What the medicine treats, e.g. "Hypertension".
  condition      String?
  /// Tablet, Capsule, Syrup... and the generic name (from the DGDA catalogue when picked there).
  form           String?
  generic        String?
  /// BEFORE_MEAL | AFTER_MEAL | WITH_MEAL | EMPTY_STOMACH | ANY_TIME
  mealTiming     String?
  /// Course: starts on startDate; endDate null = continue until stopped. Past endDate = completed.
  startDate      DateTime?
  endDate        DateTime?
  /// active=false means stopped early (by a doctor or the patient), with when and why.
  active         Boolean       @default(true)
  stoppedAt      DateTime?
  stopReason     String?
  /// Set when the medicine was added from a scanned prescription.
  prescriptionId String?
  prescription   Prescription? @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([profileId])
  @@index([prescriptionId])
}

/// A doctor's prescription, read from a photo or typed in. Medicines link back to it.
model Prescription {
  id              String       @id @default(cuid())
  profileId       String
  profile         Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  doctorName      String?
  /// e.g. "Cardiologist", "Diabetologist"
  doctorSpecialty String?
  issuedOn        DateTime?
  /// Diagnosis / what the treatment is for.
  condition       String?
  notes           String?
  medications     Medication[]
  labReports      LabReport[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([profileId, issuedOn])
}

/// Read-only link a patient can send to a doctor. Only the SHA-256 hash of the token is stored.
model ShareLink {
  id             String    @id @default(cuid())
  profileId      String
  profile        Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  tokenHash      String    @unique
  label          String
  expiresAt      DateTime
  revokedAt      DateTime?
  lastAccessedAt DateTime?
  createdAt      DateTime  @default(now())

  @@index([profileId])
}

/// Registered allopathic medicines of Bangladesh (DGDA list), for search-as-you-type when adding
/// medicines. Reference data only: reloaded from prisma/data by scripts/seed-catalog.mjs; no user data here.
model MedicineCatalog {
  id       Int     @id @default(autoincrement())
  brand    String
  /// lower-case brand for prefix search
  brandKey String
  generic  String
  strength String
  form     String
  company  String
  dar      String?

  @@index([brandKey])
  @@index([generic])
}

/// A diagnosis being treated or monitored (e.g. Hypertension since 2019). Medicines and
/// prescriptions refer to it by name in their "condition" text.
model HealthCondition {
  id          String    @id @default(cuid())
  profileId   String
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name        String
  /// ONGOING | RESOLVED
  status      String    @default("ONGOING")
  diagnosedOn DateTime?
  resolvedOn  DateTime?
  doctorName  String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([profileId])
}

/// A medical test result (CBC, HbA1c, X-ray...) with one or more photos/PDF pages,
/// optionally linked to the prescription (doctor) that asked for it.
model LabReport {
  id             String          @id @default(cuid())
  profileId      String
  profile        Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title          String
  /// Calendar date of the test, stored at UTC midnight.
  testDate       DateTime?
  labName        String?
  prescriptionId String?
  prescription   Prescription?   @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  notes          String?
  files          LabReportFile[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([profileId, testDate])
  @@index([prescriptionId])
}

/// One photo or PDF of a test report. With cloud storage set up the file lives in a private
/// Supabase bucket and only its location (storageKey) is kept here; otherwise the bytes are in
/// LabReportFileChunk. Listing files never loads the bytes.
model LabReportFile {
  id         String               @id @default(cuid())
  reportId   String
  report     LabReport            @relation(fields: [reportId], references: [id], onDelete: Cascade)
  name       String
  mimeType   String
  size       Int
  position   Int                  @default(0)
  /// Path in the storage bucket, e.g. "{userId}/{profileId}/{reportId}/{fileId}.jpg". Null = bytes in chunks.
  storageKey String?
  /// Small preview image for lists (cloud storage only).
  thumbKey   String?
  chunks     LabReportFileChunk[]
  createdAt  DateTime             @default(now())

  @@index([reportId])
}

model LabReportFileChunk {
  fileId String
  file   LabReportFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  idx    Int
  data   Bytes

  @@id([fileId, idx])
}
